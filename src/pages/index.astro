---
import Base from "../layouts/Base.astro";
import VantaHero from "../components/VantaHero";
---

<Base
  title="Raahim - Agentic AI Automation Engineer"
  description="Raahim builds AI helpers and workflow automation that cut manual work for support, sales, and operations teams."
>
  <section aria-labelledby="hero-title" class="band-wash dot-grid relative overflow-hidden">
    <VantaHero client:only="react" />
    <div class="container-page hero-layer relative py-12 text-center md:py-20">
      <div class="mx-auto max-w-[1040px]">
        <div class="flex flex-col items-center justify-center">
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-azure-deep">
            agentic ai automation engineer
          </p>
          <h1
            id="hero-title"
            class="font-display mt-4 text-4xl font-bold leading-none tracking-tight text-balance lg:text-[2.75rem] xl:text-5xl"
          ><span class="lg:block">I build automations that remove manual work<span class="lg:hidden">&nbsp;</span></span><span class="lg:block">and fix business bottlenecks.</span></h1>
          <p class="mt-4 max-w-[52ch] text-base leading-relaxed text-ink-soft">
            I build business automations, AI-powered workflows, and system
            integrations that reduce repetitive work and connect the tools
            businesses rely on.
          </p>
          <div class="mt-7 flex flex-wrap justify-center gap-3">
            <a href="/work" class="btn-primary">View my work</a>
            <a href="/contact" class="btn-secondary">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
