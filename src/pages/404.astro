---
import Base from "../layouts/Base.astro";
---

<Base
  title="Page not found - Raahim"
  description="This page is not here. Head home to keep looking."
>
  <section aria-labelledby="missing-title" class="container-page py-20 text-center md:py-28">
    <p class="font-display text-6xl font-bold text-pine">404</p>
    <h1 id="missing-title" class="font-display mt-4 text-3xl font-bold">
      This page is not here.
    </h1>
    <p class="mx-auto mt-3 max-w-[42ch] text-base text-ink-soft">
      The link may be old. Head home to keep looking.
    </p>
    <div class="mt-7 flex justify-center gap-3">
      <a href="/" class="btn-primary">Back home</a>
      <a href="/work" class="btn-secondary">View my work</a>
    </div>
  </section>
</Base>
