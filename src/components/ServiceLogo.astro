---
// Compact service-card logo marks. Same visual language as the old
// wide ServiceVisual diagrams (wash ground, line borders, pine
// accents, viz-flow / viz-pulse life) distilled into a 44px chip.
  interface Props {
    kind:
      | "process"
      | "ai"
      | "agents"
      | "integration"
      | "data"
      | "custom"
      | "chat"
      | "mail"
      | "invoice"
      | "target"
      | "scan"
      | "person"
      | "shield";
  }
const { kind } = Astro.props;
---

<svg viewBox="0 0 44 44" class="h-11 w-11 shrink-0" aria-hidden="true">
  <rect x="0.75" y="0.75" width="42.5" height="42.5" rx="11" fill="#EDF3EF" stroke="#E4E8E5" stroke-width="1.5" />

  {
    kind === "process" && (
      <g>
        <rect x="8" y="15" width="11" height="14" rx="3.5" fill="#fff" stroke="#E4E8E5" stroke-width="1.5" />
        <line x1="20" y1="22" x2="24.5" y2="22" stroke="#0E7C5B" stroke-width="2" class="viz-flow" stroke-dasharray="3 3" />
        <rect x="25" y="15" width="11" height="14" rx="3.5" fill="#0E7C5B" />
      </g>
    )
  }

  {
    kind === "ai" && (
      <path
        d="M22 9 L24.8 19.2 L35 22 L24.8 24.8 L22 35 L19.2 24.8 L9 22 L19.2 19.2 Z"
        fill="#0E7C5B"
      />
    )
  }

  {
    kind === "agents" && (
      <g>
        {[
          [13, 14],
          [31, 14],
          [13, 30],
          [31, 30],
        ].map(([sx, sy]) => (
          <line
            x1="22"
            y1="22"
            x2={sx}
            y2={sy}
            stroke="#17201D"
            stroke-opacity="0.22"
            stroke-width="1.5"
          />
        ))}
        <circle cx="22" cy="22" r="5.5" fill="#0E7C5B" />
        {[
          [13, 14],
          [31, 14],
          [13, 30],
          [31, 30],
        ].map(([sx, sy], i) => (
          <circle
            cx={sx}
            cy={sy}
            r="3.5"
            fill="#fff"
            stroke="#0E7C5B"
            stroke-width="1.5"
            class="viz-pulse"
            style={`animation-delay:${i * 0.5}s`}
          />
        ))}
      </g>
    )
  }

  {
    kind === "integration" && (
      <g>
        <line x1="17" y1="27" x2="27" y2="17" stroke="#0E7C5B" stroke-width="2" class="viz-flow" stroke-dasharray="3 3" />
        <rect x="8" y="8" width="13" height="13" rx="4.5" fill="#fff" stroke="#E4E8E5" stroke-width="1.5" />
        <rect x="23" y="23" width="13" height="13" rx="4.5" fill="#0E7C5B" />
      </g>
    )
  }

  {
    kind === "data" && (
      <g>
        <rect x="7" y="6" width="24" height="22" rx="4" fill="#EDF3EF" stroke="#0E7C5B" stroke-width="1.5" />
        <rect x="7" y="6" width="24" height="5" rx="4" fill="#0E7C5B" />
        <rect x="7" y="9" width="24" height="2" fill="#0E7C5B" />
        <rect x="9" y="13" width="20" height="5" rx="1.5" fill="#0E7C5B" fill-opacity="0.35" />
        <line x1="17" y1="6" x2="17" y2="28" stroke="#0E7C5B" stroke-opacity="0.35" />
        <line x1="25" y1="6" x2="25" y2="28" stroke="#0E7C5B" stroke-opacity="0.35" />
        <line x1="7" y1="11" x2="31" y2="11" stroke="#0E7C5B" stroke-opacity="0.35" />
        <line x1="7" y1="23" x2="31" y2="23" stroke="#0E7C5B" stroke-opacity="0.35" />
        <line x1="8" y1="35.5" x2="30" y2="35.5" stroke="#0E7C5B" stroke-width="2" class="viz-flow" />
        <path d="M30 32.5 L36 35.5 L30 38.5" fill="none" stroke="#0E7C5B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="8" cy="35.5" r="2.5" fill="#0E7C5B" class="viz-pulse" />
      </g>
    )
  }

  {
    kind === "custom" && (
      <g>
        <rect
          x="8"
          y="9"
          width="18"
          height="18"
          rx="5.5"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-dasharray="4 4"
        />
        <rect x="21" y="21" width="15" height="15" rx="5" fill="#0E7C5B" />
      </g>
    )
  }

  {
    kind === "chat" && (
      <g>
        <path
          d="M8 13 a4 4 0 0 1 4 -4 H32 a4 4 0 0 1 4 4 V24 a4 4 0 0 1 -4 4 H19 L13 34.5 V28 H12 a4 4 0 0 1 -4 -4 Z"
          fill="#0E7C5B"
        />
        {[16, 22, 28].map((cx, i) => (
          <circle
            cx={cx}
            cy="19"
            r="2.2"
            fill="#fff"
            class="viz-pulse"
            style={`animation-delay:${i * 0.35}s`}
          />
        ))}
      </g>
    )
  }

  {
    kind === "mail" && (
      <g>
        <rect
          x="6"
          y="10"
          width="26"
          height="19"
          rx="3.5"
          fill="#fff"
          stroke="#E4E8E5"
          stroke-width="1.5"
        />
        <path
          d="M7 12.5 L19 21.5 L31 12.5"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <line
          x1="11"
          y1="35"
          x2="31"
          y2="35"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-dasharray="3 3"
          class="viz-flow"
        />
        <path
          d="M31 32.5 L35.5 35 L31 37.5"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    )
  }

  {
    kind === "invoice" && (
      <g>
        <rect
          x="10"
          y="7"
          width="21"
          height="29"
          rx="3"
          fill="#fff"
          stroke="#E4E8E5"
          stroke-width="1.5"
        />
        <line
          x1="14"
          y1="14"
          x2="27"
          y2="14"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
        />
        <line
          x1="14"
          y1="19"
          x2="27"
          y2="19"
          stroke="#0E7C5B"
          stroke-opacity="0.35"
          stroke-width="2"
          stroke-linecap="round"
        />
        <line
          x1="14"
          y1="24"
          x2="22"
          y2="24"
          stroke="#0E7C5B"
          stroke-opacity="0.35"
          stroke-width="2"
          stroke-linecap="round"
        />
        <circle
          cx="32"
          cy="33"
          r="7.5"
          fill="#0E7C5B"
          stroke="#EDF3EF"
          stroke-width="2"
        />
        <path
          d="M28.8 33 L31.3 35.5 L35.5 30.8"
          fill="none"
          stroke="#fff"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    )
  }

  {
    kind === "target" && (
      <g>
        <circle cx="22" cy="22" r="14" fill="none" stroke="#0E7C5B" stroke-width="2" />
        <circle
          cx="22"
          cy="22"
          r="8.5"
          fill="none"
          stroke="#0E7C5B"
          stroke-opacity="0.45"
          stroke-width="1.5"
        />
        <circle cx="22" cy="22" r="4" fill="#0E7C5B" class="viz-pulse" />
      </g>
    )
  }

  {
    kind === "scan" && (
      <g>
        <rect
          x="15"
          y="12"
          width="14"
          height="20"
          rx="2.5"
          fill="#fff"
          stroke="#E4E8E5"
          stroke-width="1.5"
        />
        <path
          d="M9 16 V10 H15"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M35 16 V10 H29"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M9 28 V34 H15"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M35 28 V34 H29"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <line
          x1="13"
          y1="22"
          x2="31"
          y2="22"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-dasharray="6 6"
          class="viz-flow"
        />
      </g>
    )
  }

  {
    kind === "person" && (
      <g>
        <circle cx="19" cy="16" r="6.5" fill="#0E7C5B" />
        <path
          d="M8 35 a11 11 0 0 1 22 0"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2.5"
          stroke-linecap="round"
        />
        <circle
          cx="33.5"
          cy="13.5"
          r="6.5"
          fill="#0E7C5B"
          stroke="#EDF3EF"
          stroke-width="2"
        />
        <path
          d="M30.8 13.5 L32.8 15.5 L36.4 11.4"
          fill="none"
          stroke="#fff"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    )
  }

  {
    kind === "shield" && (
      <g>
        <path
          d="M22 7 L35 11.5 V22 C35 30 29 35.5 22 37.5 C15 35.5 9 30 9 22 V11.5 Z"
          fill="#fff"
          stroke="#0E7C5B"
          stroke-width="2"
          stroke-linejoin="round"
        />
        <path
          d="M16 22.5 L20.5 27 L30 17.5"
          fill="none"
          stroke="#0E7C5B"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </g>
    )
  }
</svg>
